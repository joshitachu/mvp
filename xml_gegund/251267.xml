            <OBJECT_CONTRACT>
                <TITLE>
                    <P>Food en Non-Food</P>
                </TITLE>
                <REFERENCE_NUMBER>2021 / 453 / IB</REFERENCE_NUMBER>
                <CPV_MAIN>
                    <CPV_CODE CODE="15000000"></CPV_CODE>
