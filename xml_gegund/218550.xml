                <OBJECT_DESCR ITEM="1">
                    <TITLE>
                        <P>Raamovereenkomst reparatie riolering en calamiteiten</P>
                    </TITLE>
                    <LOT_NO>1</LOT_NO>
                    <CPV_ADDITIONAL>
                        <CPV_CODE CODE="45232400"></CPV_CODE>
